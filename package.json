{
  "name": "mineral-textui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "devtools": "pnpm build && pnpm --filter @mineral/textui-devtools dev",
    "devtools:test": "pnpm build && pnpm --filter @mineral/textui-devtools test",
    "devtools:check": "pnpm build && pnpm --filter @mineral/textui-devtools check",
    "devtools:test:browser": "pnpm build && pnpm --filter @mineral/textui-devtools test:browser",
    "build": "pnpm -r --filter @mineral/* build",
    "check": "pnpm build && tsc --noEmit && node scripts/check-boundaries.mjs && pnpm --filter textui-worker-compat check && pnpm --filter textui-worker-app check && pnpm --filter textui-worker-animation check",
    "test": "pnpm build && vitest run",
    "test:workers": "pnpm build && node tests/worker-compat/verify.mjs && pnpm --filter textui-worker-app test && pnpm --filter textui-worker-animation test",
    "test:packed-worker": "pnpm build && node scripts/verify-packed-worker.mjs",
    "task-app": "pnpm build && tsx examples/task-app/run.tsx",
    "worker-app": "pnpm build && pnpm --filter textui-worker-app dev",
    "animation-demo": "pnpm build && tsx examples/animation-demo/index.ts",
    "worker-animation": "pnpm build && pnpm --filter textui-worker-animation dev",
    "animation-client": "pnpm build && tsx examples/animation-demo/worker-client.ts",
    "measure:animation": "pnpm build && tsx examples/animation-demo/measure.ts",
    "start": "pnpm user-form",
    "user-form": "pnpm build && tsx examples/user-form/run.tsx",
    "memory": "pnpm build && tsx examples/memory/run.tsx",
    "text-app": "pnpm build && tsx examples/cli/cli.ts",
    "counter": "pnpm text-app counter",
    "form": "pnpm text-app form",
    "phase3": "pnpm build && tsx examples/phase-3/run.tsx",
    "markdown-showcase": "pnpm phase3 markdown-showcase",
    "interactive-form": "pnpm phase3 interactive-form",
    "custom-block": "pnpm phase3 custom-block",
    "phase6": "pnpm build && tsx examples/phase-6/run.tsx",
    "advanced-form": "pnpm phase6 advanced-form",
    "inline-markdown-showcase": "pnpm phase6 inline-markdown-showcase",
    "pack:preview": "pnpm build && node scripts/pack-preview.mjs",
    "vscode:build": "pnpm build && pnpm --filter @mineral/textui-devtools vscode:build",
    "devtools:test:project": "pnpm build && pnpm --filter @mineral/textui-devtools test:project",
    "vscode:watch": "pnpm build && pnpm --filter @mineral/textui-devtools vscode:watch",
    "vscode:test:watch": "pnpm build && pnpm --filter @mineral/textui-devtools test:vscode-watch",
    "devtools:examples": "pnpm devtools --config examples/devtools/textui.dev.tsx",
    "devtools:test:fixtures": "pnpm build && pnpm --filter textui-devtools-fixtures test:browser",
    "devtools:test:packed": "pnpm build && node scripts/verify-packed-devtools.mjs"
  },
  "devDependencies": {
    "@mineral/textui": "workspace:*",
    "@mineral/textui-host-node": "workspace:*",
    "@mineral/textui-react": "workspace:*",
    "@types/node": "26.6.4",
    "@types/react": "19.2.2",
    "esbuild": "0.28.2",
    "mdast-util-from-markdown": "2.0.3",
    "react": "19.3.0",
    "react-router": "8.4.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0",
    "@mineral/textui-devtools": "workspace:*"
  },
  "version": "0.0.0"
}
