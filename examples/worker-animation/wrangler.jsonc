{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"mineral-textui-worker-animation",
  "main":"worker.ts",
  "compatibility_date":"2026-10-04",
  "compatibility_flags":["no_nodejs_compat","no_nodejs_compat_v2"],
  "define":{"process.env.NODE_ENV":"\"production\""},
  "durable_objects":{"bindings":[{"name":"ANIMATION_APPS","class_name":"AnimationApplication"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["AnimationApplication"]}],
  "observability":{"enabled":true,"traces":{"enabled":true}}
}
